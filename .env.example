# Miden RPC endpoint (default: testnet)
MIDEN_RPC_ENDPOINT=https://rpc.testnet.miden.io

# PSM server endpoint (required for multisig flows)
PSM_ENDPOINT=http://localhost:50051

# SQLite store path for client state persistence
SQLITE_STORE_PATH=./store.sqlite3

# Filesystem keystore path for key storage
KEYSTORE_PATH=./keystore

# Issuer account ID (set after deploying issuer with `make deploy-issuer`)
# ISSUER_ACCOUNT_ID=

# Logging level (trace, debug, info, warn, error)
LOG_LEVEL=info
